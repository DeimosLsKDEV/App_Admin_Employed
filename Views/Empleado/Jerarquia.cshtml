@model AppAdminEmployed.Models.EmpleadoModel
<style>
    .breadcrumb {
        font-size: 0.9rem;
    }

    .card {
        border-left: 4px solid #fd7e14;
    }

    .list-group-item {
        cursor: pointer;
        transition: background-color 0.2s ease;
    }

    .list-group-item:hover {
        background-color: #fff3e0;
    }
</style>

<div class="container mt-4">
    <div class="row">
        <!-- Breadcrumb -->
        @if (Model.Breadcrumb != null && Model.Breadcrumb.Any())
        {
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb bg-light p-2 rounded shadow-sm">
                    @for (int i = 0; i < Model.Breadcrumb.Count; i++)
                    {
                        var item = Model.Breadcrumb[i];
                        if (i < Model.Breadcrumb.Count - 1)
                        {
                            <li class="breadcrumb-item">
                                <a href="@Url.Action("Jerarquia", "Empleado", new { uuidBuscado = item.UUID })">
                                    @item.NOMBRE_COMPLETO
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="breadcrumb-item active" aria-current="page">@item.NOMBRE_COMPLETO</li>
                        }
                    }
                </ol>
            </nav>
        }

        <!-- Supervisor actual -->
        <div class="card p-3 shadow-sm mb-4">
            <h5 class="text-primary mb-1">
                <i class="fa fa-user text-orange"></i> @Model.NOMBRE_COMPLETO
            </h5>
            <div class="text-muted small">Identificación: @Model.IDENTIFICACION</div>
        </div>

        <!-- Subordinados -->
        @if (Model.Subordinados != null && Model.Subordinados.Any())
        {
            <h6 class="mb-2 text-secondary">Subordinados directos:</h6>
            <div class="list-group shadow-sm">
                @foreach (var sub in Model.Subordinados)
                {
                    <a href="@Url.Action("Jerarquia", "Empleado", new { uuidBuscado = sub.UUID })"
                        class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                        <span>
                            <i class="fa fa-user text-warning me-2"></i> @sub.NOMBRE_COMPLETO
                        </span>
                        <small class="text-muted">@sub.IDENTIFICACION</small>
                    </a>
                }
            </div>
        }
        else
        {
            <div class="alert alert-info mt-3">Este usuario no tiene subordinados.</div>
        }

        <!-- Botón para subir un nivel -->
        @if (Model.SUPERVISOR_UUID_VISTA.HasValue)
        {
            <div class="mt-4">
                <a href="@Url.Action("Jerarquia", "Empleado", new { uuidBuscado = Model.SUPERVISOR_UUID_VISTA })"
                    class="btn btn-outline-secondary">
                    <i class="fa fa-arrow-up"></i> Subir un nivel
                </a>
            </div>
        }
    </div>
</div>