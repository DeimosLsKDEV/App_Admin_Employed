@{
    ViewData["Title"] = "Cargar Empleados desde CSV";
}

<div class="container mt-4">
    <h2 class="mb-4 text-primary">@ViewData["Title"]</h2>

    <div class="card shadow-sm">
        <div class="card-body">
            <form id="csvForm" enctype="multipart/form-data" method="post" asp-controller="Empleado" asp-action="UploadCsv">
                <div class="mb-3">
                    <label for="file" class="form-label fw-bold">Selecciona un archivo CSV</label>
                    <input type="file" class="form-control" id="file" name="file" accept=".csv" required />
                </div>

                <div class="mb-3">
                    <div class="progress d-none" style="height: 25px;">
                        <div id="progressBar" class="progress-bar progress-bar-striped progress-bar-animated" 
                             role="progressbar" style="width: 0%">0%</div>
                    </div>
                </div>

                <button type="submit" class="btn btn-success">
                    📤 Subir CSV
                </button>
            </form>

            <div id="resultado" class="alert mt-3 d-none"></div>
        </div>
    </div>

    <hr />

    <div class="d-flex justify-content-between align-items-center mt-4 mb-2">
        <h4>📋 Empleados cargados en caché</h4>
        <button id="btnCargar" class="btn btn-outline-primary btn-sm">🔄 Actualizar lista</button>
    </div>

    <table class="table table-striped table-bordered" id="tablaEmpleados">
        <thead class="table-dark">
            <tr>
                <th>Identificación</th>
                <th>Primer Nombre</th>
                <th>Segundo Nombre</th>
                <th>Primer Apellido</th>
                <th>Segundo Apellido</th>
                <th>Supervisor</th>
            </tr>
        </thead>
        <tbody>
            <tr><td colspan="6" class="text-center text-muted">No hay datos cargados</td></tr>
        </tbody>
    </table>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <script>
        $(document).ready(function () {

            // Subir CSV con barra de progreso
            $('#csvForm').on('submit', function (e) {
                e.preventDefault();

                var formData = new FormData(this);
                var $resultado = $('#resultado');
                var $progress = $('.progress');
                var $bar = $('#progressBar');

                $resultado.addClass('d-none').removeClass('alert-success alert-danger');
                $progress.removeClass('d-none');
                $bar.css('width', '0%').text('0%');

                $.ajax({
                    xhr: function () {
                        var xhr = new window.XMLHttpRequest();
                        xhr.upload.addEventListener("progress", function (evt) {
                            if (evt.lengthComputable) {
                                var percentComplete = Math.round((evt.loaded / evt.total) * 100);
                                $bar.css('width', percentComplete + '%').text(percentComplete + '%');
                            }
                        }, false);
                        return xhr;
                    },
                    url: $(this).attr('action'),
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    beforeSend: function () {
                        $bar.css('width', '0%').text('0%');
                        $progress.removeClass('d-none');
                    },
                    success: function (data) {
                        $bar.css('width', '100%').text('100%');
                        $resultado
                            .removeClass('d-none')
                            .addClass('alert alert-success')
                            .text(data.mensaje || "Archivo procesado correctamente.");
                        cargarEmpleados();
                    },
                    error: function (xhr) {
                        $resultado
                            .removeClass('d-none')
                            .addClass('alert alert-danger')
                            .text("Error al subir el archivo: " + xhr.responseText);
                    },
                    complete: function () {
                        setTimeout(() => {
                            $progress.addClass('d-none');
                            $bar.css('width', '0%').text('0%');
                        }, 1500);
                    }
                });
            });

            // Cargar empleados desde cache
            $('#btnCargar').on('click', function () {
                cargarEmpleados();
            });

            function cargarEmpleados() {
                var $tbody = $('#tablaEmpleados tbody');
                $tbody.html('<tr><td colspan="6" class="text-center text-muted">Cargando...</td></tr>');

                $.ajax({
                    url: '/Empleado/GetCachedEmpleados',
                    type: 'GET',
                    success: function (data) {
                        if (!data || data.length === 0) {
                            $tbody.html('<tr><td colspan="6" class="text-center text-muted">No hay empleados cargados.</td></tr>');
                            return;
                        }

                        var filas = '';
                        $.each(data, function (i, e) {
                            filas += `
                                <tr>
                                    <td>${e.identificacion ?? ''}</td>
                                    <td>${e.primer_NOMBRE ?? ''}</td>
                                    <td>${e.segundo_NOMBRE ?? ''}</td>
                                    <td>${e.primer_APELLIDO ?? ''}</td>
                                    <td>${e.segundo_APELLIDO ?? ''}</td>
                                    <td>${e.guid_SUPERVISOR ?? ''}</td>
                                </tr>`;
                        });

                        $tbody.html(filas);
                    },
                    error: function () {
                        $tbody.html('<tr><td colspan="6" class="text-center text-danger">Error al obtener los datos.</td></tr>');
                    }
                });
            }

            // Cargar automáticamente al entrar
            cargarEmpleados();
        });
    </script>
}