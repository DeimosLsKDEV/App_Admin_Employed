@model List<AppAdminEmployed.Models.EmpleadoModel>

<h2>Lista de empleados</h2>
<div class='row'>
    <div class='col-12'>
    <button id="AddEmpleado" class="btn btn-success" style="width: 100%"> Agregar</button>
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Acciones</th>
                    <th>ID</th>
                    <th>Identificación</th>
                    <th>Nombre</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var empleado in Model)
                {
                    <tr>
                        <td><!--<button type="button" class="btn btn-warning"> Editar </button>--></td>
                        <td>@empleado.UUID</td>
                        <td>@empleado.IDENTIFICACION</td>
                        <td>@empleado.PRIMER_APELLIDO @empleado.SEGUNDO_APELLIDO @empleado.PRIMER_NOMBRE
                            @empleado.SEGUNDO_NOMBRE
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="modalAddEmpleado" tabindex="-1" aria-labelledby="modalAddEmpleadoLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="modalAddEmpleadoLabel">Agregar Empleado</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
      </div>
      <div class="modal-body" id="contenedor-add-empleado">
        
      </div>
    </div>
  </div>
</div>

@section Scripts {
    <script>
        $("#AddEmpleado").on("click", function () {
            RedirectContentUrl('#contenedor-add-empleado', '@Url.Action("Add","Empleado")')
            $('#modalAddEmpleado').modal('show');
        });
    </script>
}